<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-5.0.xsd">

    <changeSet id="2026-08-13-create-vehicle-types" author="xqsy">

        <createTable tableName="vehicle_types">
            <column name="code" type="varchar(30)">
                <constraints
                        primaryKey="true"
                        nullable="false"/>
            </column>
        </createTable>

        <insert tableName="vehicle_types">
            <column name="code" value="TRUCK"/>
        </insert>

        <insert tableName="vehicle_types">
            <column name="code" value="BUS"/>
        </insert>

    </changeSet>


    <changeSet id="2026-08-13-create-vehicle-conditions" author="xqsy">

        <createTable tableName="vehicle_conditions">
            <column name="code" type="varchar(30)">
                <constraints
                        primaryKey="true"
                        nullable="false"/>
            </column>
        </createTable>

        <insert tableName="vehicle_conditions">
            <column name="code" value="GOOD"/>
        </insert>

        <insert tableName="vehicle_conditions">
            <column name="code" value="NEEDS_REPAIR"/>
        </insert>

    </changeSet>


    <changeSet id="2026-08-13-create-transport-request-statuses" author="xqsy">

        <createTable tableName="transport_request_statuses">
            <column name="code" type="varchar(30)">
                <constraints
                        primaryKey="true"
                        nullable="false"/>
            </column>
        </createTable>

        <insert tableName="transport_request_statuses">
            <column name="code" value="NEW"/>
        </insert>

        <insert tableName="transport_request_statuses">
            <column name="code" value="ASSIGNED"/>
        </insert>

        <insert tableName="transport_request_statuses">
            <column name="code" value="IN_PROGRESS"/>
        </insert>

        <insert tableName="transport_request_statuses">
            <column name="code" value="COMPLETED"/>
        </insert>

        <insert tableName="transport_request_statuses">
            <column name="code" value="CANCELLED"/>
        </insert>

    </changeSet>

</databaseChangeLog>    